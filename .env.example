# Project-level model runtime settings (do not commit real keys)
OPENAI_API_KEY=

# Optional: stage-specific model override
SHOTGUNCV_ANALYZER_MODEL=
SHOTGUNCV_GENERATOR_MODEL=
SHOTGUNCV_JUDGE_MODEL=
SHOTGUNCV_PLANNER_MODEL=
SHOTGUNCV_VISION_MODEL=
SHOTGUNCV_OCR_LANGUAGES=chi+eng

# Optional: shared model override when stage-specific model is empty
# If all model settings are empty, defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Optional: OpenAI-compatible base URL.
# Keep empty for the official endpoint https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: HTTP timeout seconds. Analyzer defaults higher because CV + multi-JD
# structured analysis prompts can run longer than short generation/evaluation calls.
SHOTGUNCV_OPENAI_TIMEOUT_SEC=90
SHOTGUNCV_ANALYZER_TIMEOUT_SEC=180

# Optional: override api key variable name in this .env
OPENAI_API_KEY_ENV=

# Provider selection lives in run_config.json.
# This file only injects model/base_url/api key settings for OpenAI-style providers.
